# PostgreSQL (docker-compose)
POSTGRES_DB=quant_center
POSTGRES_USER=quant_center
POSTGRES_PASSWORD=change-me

# FastAPI backend database
DATABASE_URL=postgresql://quant_center:change-me@localhost:5432/quant_center

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-jwt-signing-secret
ENCRYPTION_SECRET_KEY=change-me-fernet-key-base64

ENVIRONMENT=dev

# Path to your Quant engines folder (backend reads signals, positions, etc.)
# Home PC:
QUANT_HOST_PATH=C:\Users\avinaash\quant
QUANT_BASE_DIR=C:\Users\avinaash\quant
OPEN_POSITIONS_FILE=C:\Users\avinaash\quant\Portfolio\trades_log.csv

# Office PC — use:
# QUANT_HOST_PATH=C:\Users\dell\quant
# QUANT_BASE_DIR=C:\Users\dell\quant

# Streamlit alerts + Google Sheet (dashboard)
